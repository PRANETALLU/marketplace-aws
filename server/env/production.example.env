# Production Environment Variables
# Copy this file for local development: cp env/production.example.env env/.production.env
# Then update with actual values

# AWS Configuration
AWS_REGION=us-east-1
ENVIRONMENT_NAME=production

# DynamoDB Table Names (auto-prefixed with "marketplace-production-")
# PRODUCTS_TABLE=marketplace-production-products
# CARTS_TABLE=marketplace-production-carts
# ORDERS_TABLE=marketplace-production-orders
# REVIEWS_TABLE=marketplace-production-reviews
# TRANSACTIONS_TABLE=marketplace-production-transactions

# Cognito
COGNITO_USER_POOL_ARN=arn:aws:cognito-idp:us-east-1:YOUR_ACCOUNT_ID:userpool/PRODUCTION_POOL_ID

# Stripe (Live Keys for Production)
STRIPE_SECRET_KEY=sk_live_YOUR_STRIPE_LIVE_SECRET_KEY

# Lambda Configuration
TIMEOUT=29
MEMORY_SIZE=256
