# Staging Environment Variables
# Copy this file for local development: cp env/staging.example.env env/.staging.env
# Then update with actual values

# AWS Configuration
AWS_REGION=us-east-1
ENVIRONMENT_NAME=staging

# DynamoDB Table Names (auto-prefixed with "marketplace-staging-")
# PRODUCTS_TABLE=marketplace-staging-products
# CARTS_TABLE=marketplace-staging-carts
# ORDERS_TABLE=marketplace-staging-orders
# REVIEWS_TABLE=marketplace-staging-reviews
# TRANSACTIONS_TABLE=marketplace-staging-transactions

# Cognito
COGNITO_USER_POOL_ARN=arn:aws:cognito-idp:us-east-1:YOUR_ACCOUNT_ID:userpool/STAGING_POOL_ID

# Stripe (Test Keys for Staging)
STRIPE_SECRET_KEY=sk_test_YOUR_STRIPE_TEST_SECRET_KEY

# Lambda Configuration
TIMEOUT=29
MEMORY_SIZE=256
