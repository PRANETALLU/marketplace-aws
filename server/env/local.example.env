# Local Development Environment Variables
# Copy this file: cp env/local.example.env env/.local.env
# Then update with your local values

# AWS Configuration (use LocalStack or AWS SAM local)
AWS_REGION=us-east-1
ENVIRONMENT_NAME=local

# DynamoDB Table Names (local)
PRODUCTS_TABLE=marketplace-local-products
CARTS_TABLE=marketplace-local-carts
ORDERS_TABLE=marketplace-local-orders
REVIEWS_TABLE=marketplace-local-reviews
TRANSACTIONS_TABLE=marketplace-local-transactions

# Cognito (use test pool or mock)
COGNITO_USER_POOL_ARN=arn:aws:cognito-idp:us-east-1:000000000000:userpool/us-east-1_LocalPoolId

# Stripe (Test Keys)
STRIPE_SECRET_KEY=sk_test_YOUR_LOCAL_TEST_KEY

# Lambda Configuration
TIMEOUT=29
MEMORY_SIZE=256

# SAM Local
SAM_CLI_TELEMETRY=0
